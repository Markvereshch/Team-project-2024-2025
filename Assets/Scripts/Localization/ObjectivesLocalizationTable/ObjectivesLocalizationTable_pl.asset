    m_Localized: Najemnik
    m_Metadata:
      m_Items: []
  - m_Id: 1002317946880
    m_Localized: Pilna dostawa
    m_Metadata:
      m_Items: []
  - m_Id: 2251096465408
    m_Localized: "Sezon polowa\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 3748039368704
    m_Localized: "Znajd\u017A i zniszcz wrogi pojazd."
    m_Metadata:
      m_Items: []
  - m_Id: 6605950033920
    m_Localized: "Dostarcz cenny \u0142adunek w wyznaczone miejsce w ograniczonym
      czasie, unikaj\u0105c atak\xF3w wroga."
    m_Metadata:
      m_Items: []
  - m_Id: 18548551196672
    m_Localized: "Zniszcz jak najwi\u0119cej wrogich pojazd\xF3w. Za ka\u017Cdy zniszczony
      pojazd otrzymasz nagrod\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 19456110501888
    m_Localized: Ochrona konwoju
    m_Metadata:
      m_Items: []
  - m_Id: 20078310334464
    m_Localized: "Przeprowad\u017A sojuszniczy pojazd, chroni\u0105c go przed atakami
      wroga."
    m_Metadata:
      m_Items: []
